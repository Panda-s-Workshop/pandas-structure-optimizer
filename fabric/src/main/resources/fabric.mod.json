{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://panda-s-workshop.github.io/pandas-structure-optimizer/",
    "sources": "https://github.com/Panda-s-Workshop/pandas-structure-optimizer",
    "issues": "https://github.com/Panda-s-Workshop/pandas-structure-optimizer/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.panda.structopt.fabric.StructOptFabric"
    ],
    "client": [
      "com.panda.structopt.fabric.client.StructOptFabricClient"
    ]
  },
  "accessWidener": "pandas_structure_optimizer.accesswidener",
  "mixins": [
    "pandas_structure_optimizer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
